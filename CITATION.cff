    given-names: "Rafael D."
    email: "rafael.d.cooelho@gmail.com"
repository-code: "https://github.com/RAFAELDCOELHO/rfbcalc"
license: MIT
version: "0.1.0"
date-released: "2026-09-02"
keywords:
  - brazil
  - taxation
  - CBS
  - IBS
  - Imposto Seletivo
  - reforma tributaria
references:
  - type: software
    title: "Calculadora de Tributos sobre o Consumo (CBS/IBS/IS)"
    authors:
      - name: "Receita Federal do Brasil"
    url: "https://piloto-cbs.tributos.gov.br/servico/calculadora-consumo/"
    notes: "Official calculation engine wrapped by this client. Source of truth."
